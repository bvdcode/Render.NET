<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <RootNamespace>Render.NET.Pdf</RootNamespace>
        <Version>0.3.3</Version>
        <Authors>Vadim Belov</Authors>
        <Company>bvdcode</Company>
        <Product>Render.NET.Pdf</Product>
        <Title>Render.NET.Pdf</Title>
        <Description>Managed PDF page rendering to RGBA and PNG for .NET. Vector paths, font outlines, images, clipping, transparency, page selection, and configurable resolution without native graphics libraries.</Description>
        <Summary>Managed PDF to PNG rendering.</Summary>
        <Copyright>Copyright © Vadim Belov 2026</Copyright>
        <NeutralLanguage>en-US</NeutralLanguage>
        <PackageId>Render.NET.Pdf</PackageId>
        <PackageTags>pdf;rendering;graphics;png;thumbnails;managed;dotnet</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>packageIcon.png</PackageIcon>
        <PackageProjectUrl>https://github.com/bvdcode/Render.NET</PackageProjectUrl>
        <RepositoryUrl>https://github.com/bvdcode/Render.NET</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReleaseNotes>Restores JP2 and raw JPEG 2000 images with our original managed Render.NET.Jpeg2000 decoder. Supports gray, RGB, CMYK, 16-bit samples, embedded opacity and external masks without CoreJ2K or native codecs. Adds independent pixel regression cases and documents unsupported extensions.</PackageReleaseNotes>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Fonts/*.ttf" />
        <None Update="Fonts/provenance.json" Pack="true" PackagePath="/fonts/" />
        <None Update="ThirdPartyNotices.txt" Pack="true" PackagePath="/" />
        <PackageReference Include="PdfPig" Version="0.1.16" />
        <PackageReference Include="StbImageSharp" Version="2.30.16" />
        <PackageReference Include="PdfPig.Filters.Jbig2.PdfboxJbig2" Version="0.1.16.2" />
        <ProjectReference Include="../Render.NET/Render.NET.csproj" />
        <ProjectReference Include="../Render.NET.Jpeg2000/Render.NET.Jpeg2000.csproj" />
        <None Include="../../README.md" Pack="true" PackagePath="/" />
        <None Include="../../LICENSE" Pack="true" PackagePath="/" />
        <None Include="../Render.NET/packageIcon.png" Pack="true" PackagePath="/" />
    </ItemGroup>

</Project>
