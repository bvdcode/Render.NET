<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <RootNamespace>Render.NET.Tgs</RootNamespace>
        <Version>0.3.19</Version>
        <Authors>Vadim Belov</Authors>
        <Company>bvdcode</Company>
        <Product>Render.NET.Tgs</Product>
        <Title>Render.NET.Tgs</Title>
        <Description>Managed selected-frame PNG rendering from Telegram TGS and Lottie JSON: animated shapes, masks, mattes, blend modes, effects, repeaters and geometric modifiers. No native graphics or animation dependencies.</Description>
        <Summary>Managed selected-frame rendering of Telegram TGS and Lottie animations to PNG using Render.NET. Animated vector shapes, keyframes and transforms without native graphics dependencies.</Summary>
        <Copyright>Copyright © Vadim Belov 2026</Copyright>
        <NeutralLanguage>en-US</NeutralLanguage>
        <PackageId>Render.NET.Tgs</PackageId>
        <PackageTags>tgs;lottie;telegram;animation;png;managed</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>packageIcon.png</PackageIcon>
        <PackageProjectUrl>https://github.com/bvdcode/Render.NET</PackageProjectUrl>
        <RepositoryUrl>https://github.com/bvdcode/Render.NET</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReleaseNotes>Plays saved property values and keyframes by default, with bounded expression execution available explicitly. Adds lazy animation frame sequences with timing and diagnostics. Fixes group opacity, trim scopes and alpha matte effects, and adds static Roughen Edges rendering. All 15 sticker fixtures render at five timeline positions.</PackageReleaseNotes>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Jint" Version="4.17.0" />
        <ProjectReference Include="../Render.NET.Svg/Render.NET.Svg.csproj" />
        <None Include="../../README.md" Pack="true" PackagePath="/" />
        <None Include="../../LICENSE" Pack="true" PackagePath="/" />
        <None Include="../Render.NET/packageIcon.png" Pack="true" PackagePath="/" />
        <None Update="ThirdPartyNotices.txt" Pack="true" PackagePath="/" />
    </ItemGroup>

</Project>
