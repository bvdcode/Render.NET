<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <RootNamespace>Render.NET.Mesh</RootNamespace>
        <Version>0.3.19</Version>
        <Authors>Vadim Belov</Authors>
        <Company>bvdcode</Company>
        <Product>Render.NET.Mesh</Product>
        <Title>Render.NET.Mesh</Title>
        <Description>Fully managed STL, OBJ, and 3MF rendering on the CPU for .NET. Includes explicit 3MF build/object selection, automatic camera framing, model rotation, configurable color, studio lighting, filtered shadows, ambient occlusion, and antialiasing. No native graphics dependencies or external renderer processes.</Description>
        <Summary>Managed STL, OBJ, and 3MF loading and studio-lit 3D previews.</Summary>
        <Copyright>Copyright © Vadim Belov 2026</Copyright>
        <NeutralLanguage>en-US</NeutralLanguage>
        <PackageId>Render.NET.Mesh</PackageId>
        <PackageTags>rendering;graphics;3d;mesh;stl;obj;3mf;png;rasterization</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>packageIcon.png</PackageIcon>
        <PackageProjectUrl>https://github.com/bvdcode/Render.NET</PackageProjectUrl>
        <RepositoryUrl>https://github.com/bvdcode/Render.NET</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReleaseNotes>Compatibility release with the SVG filter performance fix. Existing format support is unchanged.</PackageReleaseNotes>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Render.NET/Render.NET.csproj" />
        <None Include="../../README.md" Pack="true" PackagePath="/" />
        <None Include="../../LICENSE" Pack="true" PackagePath="/" />
        <None Include="../Render.NET/packageIcon.png" Pack="true" PackagePath="/" />
    </ItemGroup>

</Project>
