<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(RenderNetVersion)' == ''">
    <ProjectReference Include="../../Sources/Render.NET.Svg/Render.NET.Svg.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(RenderNetVersion)' != ''">
    <PackageReference Include="Render.NET.Svg" Version="$(RenderNetVersion)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>
  <Target Name="WriteBenchmarkVersions" AfterTargets="Build">
    <ItemGroup>
      <BenchmarkAssembly Include="@(ReferencePath)" Condition="'%(Filename)' == 'Render.NET.Svg' Or '%(Filename)' == 'Svg.Skia' Or '%(Filename)' == 'SkiaSharp'" />
    </ItemGroup>
    <GetAssemblyIdentity AssemblyFiles="@(BenchmarkAssembly)">
      <Output TaskParameter="Assemblies" ItemName="BenchmarkIdentity" />
    </GetAssemblyIdentity>
    <WriteLinesToFile File="$(TargetDir)versions.txt" Lines="@(BenchmarkIdentity->'%(Name)=%(Version)')" Overwrite="true" />
  </Target>
</Project>
