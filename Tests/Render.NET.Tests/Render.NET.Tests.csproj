    <ProjectReference Include="../../Sources/Render.NET.Jbig2/Render.NET.Jbig2.csproj" />
    <ProjectReference Include="../../Sources/Render.NET.Jpeg2000/Render.NET.Jpeg2000.csproj" />
    <ProjectReference Include="../../Sources/Render.NET.Mesh/Render.NET.Mesh.csproj" />
    <ProjectReference Include="../../Sources/Render.NET.Pdf/Render.NET.Pdf.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../Fixtures/**/*" Link="Fixtures/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
